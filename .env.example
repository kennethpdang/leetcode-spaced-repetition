# Connection string for your Postgres database (from Neon).
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# A long random string used to sign sign-in sessions. Keep it secret.
SESSION_SECRET=replace-with-a-long-random-string

# Optional, for adding problems automatically from NeetCode (see "Adding problems automatically from NeetCode" in README.md).
# The same random string you enter as the secret on the GitHub webhook.
GITHUB_WEBHOOK_SECRET=replace-with-another-long-random-string
# The email of the account on this site that synced problems are added to.
NEETCODE_SYNC_EMAIL=you@example.com
